rules_version = '2';
// Security rules for 1v1 Duel (online mode).
// Paste this whole file into Firebase console -> Firestore Database -> Rules -> Publish
// (or deploy from a terminal: npx firebase-tools deploy --only firestore).
//
// What they guarantee:
//  - Only signed-in players can read anything.
//  - You can only edit YOUR OWN profile; your 8-digit ID can never change or be reused.
//  - Score can only move by a plausible amount per write (−60…+60), never below 0.
//    (A determined cheater could still fake answers from the browser — fully
//     cheat-proof scoring needs Cloud Functions, which require the paid Blaze plan.)
//  - Follower counts can only change by +1/-1 together with a real follow document.
//  - Friend requests: only you can send yours; only the OTHER person can accept.
//  - Duel challenges: only between accepted friends, readable only by the two players.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    // The administrator: the account with this Gmail, and only after it is VERIFIED
    // (keep in sync with js/admin-config.js).
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'madam1novde@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function validUser(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 40
        && d.surname is string && d.surname.size() > 0 && d.surname.size() <= 40
        && d.publicId is string && d.publicId.size() == 8
        && d.score is int && d.score >= 0
        && d.monthScore is int && d.monthScore >= 0
        && d.monthKey is string && d.monthKey.size() == 7
        && (d.avatar == null || (d.avatar is string && d.avatar.size() < 100000))
        && (!('tgUsername' in d) || (d.tgUsername is string && d.tgUsername.size() <= 40));
    }
    function followDoc(from, to) { return /databases/$(database)/documents/follows/$(from + '_' + to); }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && me() == uid && validUser(request.resource.data)
        && request.resource.data.score == 0 && request.resource.data.monthScore == 0
        && request.resource.data.get('followers', 0) == 0
        && request.resource.data.get('verified', false) == false
        && get(/databases/$(database)/documents/ids/$(request.resource.data.publicId)).data.uid == me();
      // the owner: profile fields and score (plausible change per write); never their own follower count
      allow update: if signedIn() && me() == uid && validUser(request.resource.data)
        && request.resource.data.publicId == resource.data.publicId
        && request.resource.data.get('followers', 0) == resource.data.get('followers', 0)
        && request.resource.data.get('verified', false) == resource.data.get('verified', false)
        && request.resource.data.score - resource.data.score <= 60
        && request.resource.data.score - resource.data.score >= -60
        && ((request.resource.data.monthKey != resource.data.monthKey
               && request.resource.data.monthScore <= 60)
            || (request.resource.data.monthKey == resource.data.monthKey
               && request.resource.data.monthScore - resource.data.monthScore <= 60
               && request.resource.data.monthScore - resource.data.monthScore >= -60));
      // anyone else: only "followers", only by exactly +1 / -1, and only together
      // with creating / deleting their own follows/{me_uid} document — so the
      // count always equals the real number of followers.
      allow update: if signedIn() && me() != uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followers'])
        && ((request.resource.data.followers == resource.data.get('followers', 0) + 1
               && existsAfter(followDoc(me(), uid)) && !exists(followDoc(me(), uid)))
            || (request.resource.data.followers == resource.data.get('followers', 0) - 1
               && !existsAfter(followDoc(me(), uid)) && exists(followDoc(me(), uid))));
      // the admin may correct scores and give the verified badge
      allow update: if isAdmin();
      allow delete: if false;
    }

    // questions each player has already seen: {subject: [question ids]}
    match /seen/{uid} {
      allow read: if signedIn() && (me() == uid || isAdmin());
      allow create, update: if signedIn() && me() == uid;
      allow delete: if false;
    }
    // phone number of each user: only the owner and the admin can read it
    match /private/{uid} {
      allow read: if signedIn() && (me() == uid || isAdmin());
      allow create, update: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['phone', 'updatedAt'])
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 24;
      allow delete: if false;
    }

    match /follows/{fid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.from == me()
        && request.resource.data.to is string && request.resource.data.to != me()
        && fid == me() + '_' + request.resource.data.to;
      allow delete: if signedIn() && resource.data.from == me();
      allow update: if false;
    }

    // Direct messages. A conversation can be opened only if one of the two follows
    // the other, or they are friends. Only the two participants can read or write.
    function chatUsers(cid) { return get(/databases/$(database)/documents/chats/$(cid)).data.users; }
    match /chats/{cid} {
      allow read: if signedIn() && (resource == null || me() in resource.data.users || isAdmin());
      allow create: if signedIn()
        && request.resource.data.users is list && request.resource.data.users.size() == 2
        && me() in request.resource.data.users
        && request.resource.data.users[0] < request.resource.data.users[1]
        && cid == request.resource.data.users[0] + '_' + request.resource.data.users[1]
        && (exists(followDoc(request.resource.data.users[0], request.resource.data.users[1]))
            || exists(followDoc(request.resource.data.users[1], request.resource.data.users[0]))
            || (exists(/databases/$(database)/documents/friendships/$(cid))
                && get(/databases/$(database)/documents/friendships/$(cid)).data.status == 'accepted'));
      allow update: if signedIn() && me() in resource.data.users
        && request.resource.data.users == resource.data.users
        && request.resource.data.get('lastText', '').size() <= 120;
      allow delete: if false;
      match /messages/{mid} {
        allow read: if signedIn() && (isAdmin() || me() in chatUsers(cid));
        allow create: if signedIn() && me() in chatUsers(cid)
          && request.resource.data.from == me()
          && ((request.resource.data.get('type', 'text') == 'text'
                && request.resource.data.text is string
                && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000)
              || (request.resource.data.get('type', '') in ['image', 'voice', 'file']
                && request.resource.data.media is string && request.resource.data.media.size() < 1000000));
        allow update, delete: if false;
      }
    }

    // Random-opponent queue: your own entry is yours; someone else may only switch a
    // waiting entry to "matched" by them, together with creating the match itself.
    match /queue/{qid} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn() && qid == me();
      allow update: if signedIn() && qid != me()
        && resource.data.status == 'waiting'
        && request.resource.data.status == 'matched' && request.resource.data.matchedBy == me()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'matchId', 'matchedBy'])
        && existsAfter(/databases/$(database)/documents/challenges/$(request.resource.data.matchId));
    }

    // 4v4 rooms: the host controls the room; other players may only add, change or
    // remove THEIR OWN entry in `players`. At most 8 players.
    match /rooms/{rid} {
      allow read: if signedIn();
      allow create: if signedIn() && rid.size() == 12 && request.resource.data.host == me()
        && request.resource.data.players.size() == 1 && me() in request.resource.data.players;
      allow update: if signedIn() && resource.data.host == me() && request.resource.data.host == me()
        && request.resource.data.players.size() <= 8;
      allow update: if signedIn() && resource.data.host != me()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['players'])
        && request.resource.data.players.diff(resource.data.players).affectedKeys().hasOnly([me()])
        && request.resource.data.players.size() <= 8;
      allow delete: if signedIn() && resource.data.host == me();
    }

    // sha256(phone) -> country code; lets sign-in work even if the wrong country
    // is selected. Readable before login, create-only, holds no phone number.
    match /phones/{h} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['dial'])
        && request.resource.data.dial is string && request.resource.data.dial.size() <= 4;
      allow update, delete: if false;
    }

    // 8-digit public ID -> uid. Create-only, so an ID can never be taken over.
    match /ids/{pid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == me() && pid.size() == 8;
      allow update, delete: if false;
    }

    // Doc id = the two uids sorted and joined with "_".
    match /friendships/{fid} {
      allow read: if signedIn() && (resource == null || me() in resource.data.users || isAdmin());
      allow create: if signedIn()
        && request.resource.data.requester == me()
        && request.resource.data.status == 'pending'
        && request.resource.data.users is list && request.resource.data.users.size() == 2
        && me() in request.resource.data.users
        && request.resource.data.users[0] < request.resource.data.users[1]
        && fid == request.resource.data.users[0] + '_' + request.resource.data.users[1];
      allow update: if signedIn() && me() in resource.data.users
        && resource.data.requester != me()
        && request.resource.data.status == 'accepted'
        && request.resource.data.users == resource.data.users
        && request.resource.data.requester == resource.data.requester;
      allow delete: if signedIn() && me() in resource.data.users;
    }

    match /challenges/{cid} {
      function friendship(pair) { return get(/databases/$(database)/documents/friendships/$(pair)).data; }
      allow read: if signedIn() && (resource == null || me() == resource.data.from || me() == resource.data.to || isAdmin());
      function queueAfter(u) { return getAfter(/databases/$(database)/documents/queue/$(u)).data; }
      allow create: if signedIn()
        && request.resource.data.from == me()
        && request.resource.data.to is string && request.resource.data.to != me()
        && request.resource.data.qs is list && request.resource.data.qs.size() <= 10
        && ((request.resource.data.status == 'pending'
              && friendship(request.resource.data.pair).status == 'accepted'
              && me() in friendship(request.resource.data.pair).users
              && request.resource.data.to in friendship(request.resource.data.pair).users)
            // random opponent: created in the same transaction that claims their queue entry
            || (request.resource.data.get('kind', '') == 'random' && request.resource.data.status == 'accepted'
              && queueAfter(request.resource.data.to).matchId == cid
              && queueAfter(request.resource.data.to).matchedBy == me()));
      allow update: if signedIn() && (me() == resource.data.from || me() == resource.data.to)
        && request.resource.data.from == resource.data.from
        && request.resource.data.to == resource.data.to
        && request.resource.data.qs == resource.data.qs
        && request.resource.data.subj == resource.data.subj;
      allow delete: if false;
    }
  }
}
